{
  "$description": "Mal design tokens (W3C DTCG format). The single source of truth for web and native. Edit here, then run `npm run tokens`.",
  "palette": {
    "$description": "Tier 1, primitives. Raw values; components never use these directly.",
    "emerald": {
      "$type": "color",
      "50": { "$value": "#ecf7f3" },
      "100": { "$value": "#d2ede3" },
      "200": { "$value": "#a6dac8" },
      "300": { "$value": "#6fc0a6" },
      "400": { "$value": "#3da283" },
      "500": { "$value": "#1f8567" },
      "600": { "$value": "#136b53" },
      "700": { "$value": "#0f5644" },
      "800": { "$value": "#0d4537" },
      "900": { "$value": "#0b392e" },
      "950": { "$value": "#05201a" }
    },
    "gold": {
      "$type": "color",
      "50": { "$value": "#fbf7ec" },
      "100": { "$value": "#f5ebcf" },
      "200": { "$value": "#ebd59e" },
      "300": { "$value": "#dfba66" },
      "400": { "$value": "#d4a23e" },
      "500": { "$value": "#b9862a" },
      "600": { "$value": "#976a21" },
      "700": { "$value": "#77521e" },
      "800": { "$value": "#5f421d" },
      "900": { "$value": "#4f381c" }
    },
    "sand": {
      "$type": "color",
      "0": { "$value": "#ffffff" },
      "25": { "$value": "#fcfbf8" },
      "50": { "$value": "#f7f5f0" },
      "100": { "$value": "#efece4" },
      "200": { "$value": "#e2ddd2" },
      "300": { "$value": "#cbc4b6" },
      "400": { "$value": "#a39b8b" },
      "500": { "$value": "#7c7466" },
      "600": { "$value": "#5e574b" },
      "700": { "$value": "#463f35" },
      "800": { "$value": "#2e2923" },
      "850": { "$value": "#242019" },
      "900": { "$value": "#1c1915" },
      "950": { "$value": "#12100d" }
    },
    "red": {
      "$type": "color",
      "50": { "$value": "#fdf0ee" },
      "100": { "$value": "#fadbd6" },
      "300": { "$value": "#f09a8c" },
      "400": { "$value": "#e56a57" },
      "500": { "$value": "#d14334" },
      "600": { "$value": "#b3321f" },
      "700": { "$value": "#8f2718" },
      "900": { "$value": "#4a160e" }
    },
    "amber": {
      "$type": "color",
      "50": { "$value": "#fef6e7" },
      "100": { "$value": "#fde8c0" },
      "300": { "$value": "#f5c26b" },
      "400": { "$value": "#f0a63a" },
      "600": { "$value": "#a15c07" },
      "700": { "$value": "#7e4806" },
      "900": { "$value": "#3f2604" }
    }
  },
  "color": {
    "$description": "Tier 2, semantic colours per theme. Every theme must define the same keys.",
    "light": {
      "$type": "color",
      "canvas": { "$value": "{palette.sand.50}" },
      "surface": { "$value": "{palette.sand.0}" },
      "surface-sunken": { "$value": "{palette.sand.100}" },
      "surface-hover": { "$value": "{palette.sand.100}" },
      "surface-active": { "$value": "{palette.sand.200}" },
      "fg": { "$value": "{palette.sand.900}" },
      "fg-muted": { "$value": "{palette.sand.600}" },
      "fg-subtle": { "$value": "{palette.sand.500}" },
      "fg-inverse": { "$value": "{palette.sand.0}" },
      "fg-on-brand": { "$value": "{palette.sand.0}" },
      "border": { "$value": "{palette.sand.200}" },
      "border-strong": { "$value": "{palette.sand.500}" },
      "border-focus": { "$value": "{palette.emerald.600}" },
      "brand": { "$value": "{palette.emerald.700}" },
      "brand-hover": { "$value": "{palette.emerald.900}" },
      "brand-active": { "$value": "{palette.emerald.950}" },
      "brand-subtle": { "$value": "{palette.emerald.50}" },
      "brand-fg": { "$value": "{palette.emerald.700}" },
      "accent": { "$value": "{palette.gold.400}" },
      "accent-subtle": { "$value": "{palette.gold.50}" },
      "accent-fg": { "$value": "{palette.gold.700}" },
      "success": { "$value": "{palette.emerald.600}" },
      "success-subtle": { "$value": "{palette.emerald.50}" },
      "success-fg": { "$value": "{palette.emerald.700}" },
      "danger": { "$value": "{palette.red.600}" },
      "danger-hover": { "$value": "{palette.red.700}" },
      "danger-subtle": { "$value": "{palette.red.50}" },
      "danger-fg": { "$value": "{palette.red.700}" },
      "warning": { "$value": "{palette.amber.400}" },
      "warning-subtle": { "$value": "{palette.amber.50}" },
      "warning-fg": { "$value": "{palette.amber.700}" }
    },
    "dark": {
      "$type": "color",
      "canvas": { "$value": "{palette.sand.950}" },
      "surface": { "$value": "{palette.sand.900}" },
      "surface-sunken": { "$value": "{palette.sand.950}" },
      "surface-hover": { "$value": "{palette.sand.850}" },
      "surface-active": { "$value": "{palette.sand.800}" },
      "fg": { "$value": "{palette.sand.50}" },
      "fg-muted": { "$value": "{palette.sand.300}" },
      "fg-subtle": { "$value": "{palette.sand.400}" },
      "fg-inverse": { "$value": "{palette.sand.950}" },
      "fg-on-brand": { "$value": "{palette.emerald.950}" },
      "border": { "$value": "{palette.sand.800}" },
      "border-strong": { "$value": "{palette.sand.500}" },
      "border-focus": { "$value": "{palette.emerald.300}" },
      "brand": { "$value": "{palette.emerald.300}" },
      "brand-hover": { "$value": "{palette.emerald.200}" },
      "brand-active": { "$value": "{palette.emerald.100}" },
      "brand-subtle": { "$value": "{palette.emerald.950}" },
      "brand-fg": { "$value": "{palette.emerald.300}" },
      "accent": { "$value": "{palette.gold.300}" },
      "accent-subtle": { "$value": "{palette.gold.900}" },
      "accent-fg": { "$value": "{palette.gold.200}" },
      "success": { "$value": "{palette.emerald.400}" },
      "success-subtle": { "$value": "{palette.emerald.950}" },
      "success-fg": { "$value": "{palette.emerald.300}" },
      "danger": { "$value": "{palette.red.400}" },
      "danger-hover": { "$value": "{palette.red.300}" },
      "danger-subtle": { "$value": "{palette.red.900}" },
      "danger-fg": { "$value": "{palette.red.300}" },
      "warning": { "$value": "{palette.amber.300}" },
      "warning-subtle": { "$value": "{palette.amber.900}" },
      "warning-fg": { "$value": "{palette.amber.300}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "IBM Plex Sans Arabic", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "30px" },
      "display": { "$value": "36px" }
    },
    "lineHeight": {
      "$type": "dimension",
      "xs": { "$value": "16px" },
      "sm": { "$value": "20px" },
      "md": { "$value": "24px" },
      "lg": { "$value": "28px" },
      "xl": { "$value": "28px" },
      "2xl": { "$value": "32px" },
      "3xl": { "$value": "36px" },
      "display": { "$value": "44px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "spacing": {
    "$description": "4px grid. Keys follow Tailwind (key x 4px).",
    "$type": "dimension",
    "0": { "$value": "0px" },
    "px": { "$value": "1px" },
    "0.5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "1.5": { "$value": "6px" },
    "2": { "$value": "8px" },
    "2.5": { "$value": "10px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "14px" },
    "xl": { "$value": "20px" },
    "full": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": [{"color": "#12100d0f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px"}] },
    "md": { "$value": [{"color": "#12100d14", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "-2px"}, {"color": "#12100d0a", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px"}] },
    "lg": { "$value": [{"color": "#12100d24", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "-8px"}, {"color": "#12100d0d", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px"}] }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "normal": { "$value": "200ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] }
  }
}
